NODEMAILER_MAIL=email for sending registration and password reset emails
NODEMAILER_PASSWORD=SMTP password for the email address specified in NODEMAILER_MAIL
NODE_ENV=development|production
PORT=8000
SUPPORT_MAIL=email for receiving support requests
ZOHO_BASE_URL=base URL for Zoho API
ZOHO_CLIENT_ID=client ID for Zoho API
ZOHO_CLIENT_SECRET=client secret for Zoho API
ZOHO_REFRESH_TOKEN=refresh token for Zoho API
ZOHO_SCOPE=permissions for Zoho API access, comma separated list of scopes
ZOHO_PORTAL_BASE_URL=base URL for Zoho portal API (tasks and worklogs)
ERP_CLIENT_KEYS=secret keys of Calculus ERP for /api/sendgrid (min 32 chars, comma separated for rotation)
# Optional
WS_URL=Calculus WS URL (default https://skenirajfiskal.calculus.rs/CWSFiskaliQR/CalculusWebService.asmx)
UPLOADS_DIR=folder for temporary uploads (default ./uploads)
SENDGRID_RATE_LIMIT_PER_MINUTE=max requests to /api/sendgrid per IP per minute (default 60)
PUBLIC_BASE_URL=public https address of this API that SendGrid posts webhook events to (set in web.config on IIS)
DATA_DIR=folder for the SendGrid webhook events SQLite database (default ./data, set in web.config on IIS)
SENDGRID_EVENTS_RETENTION_DAYS=days to keep webhook events (default 30)
